# Copy this file to secrets.yaml (which is git-ignored) and replace every value.
# ESPHome reads `!secret` entries from secrets.yaml in the same folder as jkbms.yaml.
wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"
# 32-byte base64 key; generate with: openssl rand -base64 32
api_encryption_key: "CHANGE_ME"
ota_password: "CHANGE_ME"
